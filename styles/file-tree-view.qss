QTreeView#fileTreeView {
	background-color: #171B22;
	alternate-background-color: #1C222B;

	color: #E1E8F2;
	
	border: 1px solid #303A47;
	border-radius: 8px;
	
	padding: 6px;
	outline: none;
}

QTreeView#fileTreeView::item {
	padding: 7px 8px;
	border: none;
	border-radius: none;
}

QTreeView#fileTreeView::item:hover {
	background-color: #252D38;
}

QTreeView#fileTreeView::item:selected {
	background-color: #303A50;
	color: #FFFFFF;
}

QHeaderView::section {
	background-color: #202731;
	color: #93A1B5;
	
	padding: 8px 10px;
	
	border: none;
	border-bottom: 1px solid #303A47;
	
	font-weight: 600;
}

QTreeView#fileTreeView {
	outline: none;
}

QTreeView#fileTreeView::item:focus {
	outline: none;
	border: none;
}