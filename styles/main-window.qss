QMainWindow#mainWindow {
	background-color: #171B22;
	color: #E1E8F2;
}

QSplitter#mainSplitter {
	background-color: #171B22;
	border: none;
}

QSplitter#mainSplitter::handle:horizontal {
	background-color: #303A47;
	width: 5px;
	margin: 0;
}

QSplitter#mainSplitter::handle:horizontal:hover {
	background-color: #777BFF;
}

QSplitter#mainSplitter::handle:horizontal:pressed {
	background-color: #6266DF;
}

QTabWidget#contentTabs {
	background-color: #171B22;
	border: none;
}

QTabWidget#contentTabs::pane {
	background-color: #171B22;
	
	border: 1px solid #303A47;
	border-radius: 0px 0px 8px 8px;
	
	top: -1px;
}

QTabWidget#contentTabs QStackedWidget#qt_tabwidget_stackedwidget {
	background-color: #171B22;
	border: none;
}

QTabWidget#contentTabs QTabBar::tab {
	background-color: #202731;
	color: #93A1B5;
	
	border: 1px solid #303A47;
	border-bottom: none;
	
	border-top-left-radius: 7px;
	border-top-right-radius: 7px;
	
	padding: 9px 18px;
	margin-right: 4px;
	
	min-width: 75px;
	
	font-size: 13px;
}

QTabWidget#contentTabs QTabBar::tab:hover {
	background-color: #252D38;
	color: #E1E8F2;
}

QTabWidget#contentTabs QTabBar::tab:selected {
	background-color: #1C222B;
	color: #E1E8F2;
	
	border-bottom: 1px solid #1C222B;
	
	font-weight: 600;
}

QTabWidget#contentTabs QTabBar::tab:!selected {
	margin-top: 2px;
}

QWidget#contentTabsContainer {
	background-color: #171B22;
	border: none;
}