QTableView#comparisonView {
	background-color: #171B22;
	alternate-background-color: #1C222B;
	
	color: #E1E8F2;
	
	border: 1px solid #303A47;
	border-radius: 8px;
	
	gridline-color: transparent;
	outline: none;
	
	selection-background-color: #30385A;
	selection-color: #FFFFFF;
	
	font-size: 13px;
}

QTableView#comparisonView::item {
	padding: 8px;
	
	border: none;
	border-bottom: 1px solid #252D38;
}

QTableView#comparisonView::item:hover {
	background-color: #252D38;
}
QTableView#comparisonView::item:selected {
	background-color: #30385A;
	color: #FFFFFF;
}

QTableView#comparisonView QHeaderView::section {
	background-color: #202731;
	
	color: #93A1B5;
	
	border: none;
	border-bottom: 1px solid #303A47;
	
	padding: 10px 8ps;
	
	font-size: 12px;
	font-weight: 600;
}

QTableView#comparisonView QTableCornerButton::section {
	background-color: #202731;
	border: none;
}