QWidget#scanHistoryPanel {
	background-color: #1C222B;
	border: 1px solid #303A47;
	border-radius: 10px;
}

QLabel#scanHistoryTitle {
	color: #E1E8F2;
	
	font-size: 15px;
	font-weight: 600;
}

QLabel#scanHistoryCount {
	color: #93A1B5;
	
	font-size: 12px;
}

QTableView#scanHistoryTable {
	background-color: #171B22;
	alternate-background-color: #1C222B;
	
	color: #E1E8F2;
	
	border: 1px solid #303F47;
	border-radius: 7px;
	
	gridline-color: transparent;
	
	selection-background-color: #30385A;
	selection-color: #FFFFFF;
	
	outline: none;
	
	font-size: 13px;
}

QTableView#scanHistoryTable::item {
	padding: 8px;
	
	border: none;
	border-bottom: 1px solid #252D38;
}

QTableView#scanHistoryTable::item:hover {
	background-color: #252D38;
}

QTableiew#scanHistoryTable::item:selected {
	background-color: #30385A;
	color: #FFFFFF;
}

QTableView#scanHistoryTable QHeaderView::section {
	background-color: #202731;
	
	color: #93A1B5;
	
	border: none;
	border-bottom: 1px solid #303A47;
	
	padding: 10px 8px;
	
	font-size: 12px;
	font-weight: 600;
}

QTableView#scanHistoryTable QTableCornerButton::section {
	background-color: #202731;
	border: none;
}